# Required when LLM_PROVIDER=openai (default)
OPENAI_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=

# Anthropic — set these to test with Claude Sonnet 5
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=

# Required (Data Commons)
DC_API_KEY=

# Data Commons MCP (local container)
DATACOMMONS_CONTAINER_PORT=3000
DATACOMMONS_URI=http://data-commons-mcp:3000/mcp

# Docker Hub images — pull/run: uncomment these, comment local build lines, then:
#   docker compose pull && docker compose up --no-build
# ASSISTANT_IMAGE=jeffgunderson/public-data-assistant:latest
# DATACOMMONS_MCP_IMAGE=jeffgunderson/data-commons-mcp:latest

# Local build — default for development: docker compose up --build
ASSISTANT_IMAGE=public-data-assistant:local
DATACOMMONS_MCP_IMAGE=data-commons-mcp:local

# Assistant UI (host)
ASSISTANT_HOST_PORT=8052
ASSISTANT_BIND=127.0.0.1

# Shared AI Solution Requirements Definition folder (sibling of this repo)
SDOH_DOCUMENTS_HOST=../sdoh_documents
DOCUMENTS_ROOT=/documents

# Optional: CDC PLACES Socrata app token (higher rate limits on data.cdc.gov)
# CDC_PLACES_APP_TOKEN=
